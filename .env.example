# Copia este archivo a ".env" (nunca se sube a git) y llena los valores reales.
#
# CADA AMBIENTE (Dev/QA/PRD) DEBE TENER SU PROPIO .env, CON:
#   - Su propio proyecto de Supabase (DATABASE_URL, SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY)
#   - Su propio JWT_SECRET_KEY
# Nunca compartas estos valores entre ambientes — si QA y PRD comparten base de datos o
# secreto de JWT, una prueba en QA puede tocar datos reales de PRD (o un token de QA
# terminaría siendo válido en PRD).

# Postgres de Supabase — Project Settings -> Database -> Connection string (URI)
DATABASE_URL=postgresql://postgres:[password]@[host]:5432/postgres

# IA (Gemini) — puede compartirse entre ambientes si no te preocupa mezclar el gasto/cuota
GEMINI_API_KEY=

# Genera una DISTINTA por ambiente:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=

# Orígenes permitidos por CORS — la(s) URL(s) del frontend de ESTE ambiente (local o túnel).
# regenerar-tunel.ps1 actualiza esta línea solo automáticamente cada vez que genera un túnel
# nuevo para ESTA carpeta.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# "development" muestra /docs, /redoc y el schema OpenAPI sin autenticación. Usa
# "production" en QA y en PRD — no solo en PRD — para no exponer la superficie de la API.
ENVIRONMENT=development

# Supabase Storage (avatares, portadas) — Project Settings -> API
SUPABASE_URL=https://[project-ref].supabase.co
SUPABASE_SERVICE_ROLE_KEY=
